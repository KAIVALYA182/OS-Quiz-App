{
  "name": "os-quiz-app-backend",
  "version": "1.0.0",
  "description": "Backend for the OS Concepts Quiz App \u2014 Database (Supabase/Postgres) + Scoring/Feedback modules",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "seed": "node scripts/validateQuestions.js && node scripts/seed.js",
    "validate:questions": "node scripts/validateQuestions.js",
    "test:scoring": "node scripts/testScoring.js",
    "migrate": "node scripts/migrate.js",
    "test": "node scripts/testScoring.js && node --test tests/*.test.js",
    "db:init": "node scripts/initSchema.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "embedded-postgres": "^18.4.0-beta.17",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=22"
  }
}
